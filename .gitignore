# 参考用的第三方仓库克隆(自带 .git,不入库)
jailbreak-tools/kindle-screensavers/

# 运行日志
*.log
__pycache__/

# Python 虚拟环境(gen_tables.py 预生成农历表用)
.venv/

# Rust 构建产物与打包出的 .app(运行时数据目录 out/ 也在 target/ 内)
dashboard-rs/target/
dashboard-rs/*.app

# Windows 交叉编译产物
dashboard-rs/dist-windows/
dashboard-rs/*.zip

# 本机/设备私钥，禁止提交
/kindle-fixes/dropbear_ed25519_host_key

# 渲染运行时输出(dashboard.png/渲染中间件/预览图)
dashboard-rs/out/
